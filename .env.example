# Django Configuration
DEBUG=True
SECRET_KEY=your_secret_key_here

# Database Configuration (MySQL)
DB_ENGINE=mysql
DB_USERNAME=your_db_username
DB_PASS=your_db_password
DB_HOST=your_db_host
DB_PORT=3306
DB_NAME=your_database_name

# Email Configuration
EMAIL_HOST=your_email_host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=your_default_from_email

# Celery Configuration (RabbitMQ)
CELERY_BROKER_USER=your_celery_user
CELERY_BROKER_PASSWORD=your_celery_password
CELERY_BROKER_HOST=localhost
CELERY_BROKER_PORT=5672
CELERY_BROKER_VHOST=your_vhost

# Optional - for deployment
RENDER_EXTERNAL_HOSTNAME=your_render_hostname

# ==========================================
# Airtable Sync Configuration
# ==========================================
# Usa AIRTABLE_TOKEN (recomendado, Personal Access Token) o AIRTABLE_API_KEY (legacy)
AIRTABLE_TOKEN=your_personal_access_token_here
# AIRTABLE_API_KEY=your_legacy_api_key_here  # Alternativa legacy
AIRTABLE_BASE_ID=your_base_id_here
AIRTABLE_TABLE_NAME=your_table_name_here

# MySQL configuration for Airtable sync (if different from main DB)
# If not set, will use DB_HOST, DB_USERNAME, DB_PASS, DB_NAME from above
MYSQL_HOST=${DB_HOST}
MYSQL_USER=${DB_USERNAME}
MYSQL_PASSWORD=${DB_PASS}
MYSQL_DATABASE=${DB_NAME}

# Configuración de la aplicación
MOVILES_EMPRESA_ID=1
MOVILES_AREA_ID=1

# Opcional: permitir crear móviles placeholder cuando falta patente
ALLOW_PLACEHOLDER_MOVIL=false
PLACEHOLDER_MOVIL_PREFIX=UNKNOWN

# --- Alertas por WhatsApp (Vogel WhatsApp API) ---
# Ver utiles/notificaciones.py y docs/ALERTAS.md
WHATSAPP_ENABLED=False
WHATSAPP_API_URL=https://whatsapp.vogelconsultoria.com.ar
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_ID=default
WHATSAPP_API_TIMEOUT=15
WHATSAPP_PUBLIC_BASE_URL=https://portal.anasociados.com.ar
# Numeros internacionales sin + ni espacios, separados por coma
ALERTA_WHATSAPP_DESTINATARIOS=
# Numeros que validan las evidencias que suben los responsables.
# Si queda vacio, se usan los de arriba.
ALERTA_WHATSAPP_ADMINISTRADORES=
